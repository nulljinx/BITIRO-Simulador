// FIRVI 2025 · programa de REFERENCIA para la prueba de integración (NO es el programa inicial de los estudiantes).
// Variante HEAD-CANVAS (sensores 6 cm delante del eje con 2,8 cm de separación; sonar a 9,83 cm del eje). La variante original, afinada para la geometría
// medida de main (sensores a 8 cm, sonar a 7,40 cm), se conserva como referencia histórica en reference-program-main-geometry.iroh.
// Solo usa sus sensores (3 de línea y sonar), el servo de golpe y el tiempo. No conoce coordenadas, rutas ni la posición de los prismas.
//  · Sigue la línea con los tres sensores (giro fuerte si solo ve un lado, suave si ve el centro y un lado).
//  · Los sensores van delante del eje: al acabarse una curva el robot aún no ha terminado de girar. Recuerda (acc) si venía corrigiendo
//    hacia un lado y, al perder la línea, termina ese giro un instante antes de avanzar recto (una vez cada 15 s, ver hold).
//  · Con los sensores separados 2,8 cm hay una franja muerta: si el robot se desvía ≈ 1,3–1,6 cm de la cinta, ni el central ni uno lateral la leen (con 1,9 cm
//    de separación apenas existe). Al perder la línea (lost) el programa «busca» con un pequeño balanceo —primero hacia el lado del último giro (≈ 0,3 s) y luego
//    hacia el otro (≈ 0,7 s)— y solo después avanza recto. Así recupera la cinta en el tramo recto sin dejar tramos ciegos largos, y los gaps (7, 23 y 7 cm) se
//    cruzan igual: el balanceo es de unos pocos grados y el robot los atraviesa sin salir del eje del gap.
//  · Los gaps se cruzan avanzando recto mientras no hay línea (lost); al volver a verla sigue normal.
//  · Cuando el sonar ve un objeto a menos de 22 cm, se acerca despacio SIGUIENDO la línea hasta quedar a 10 cm (distancia de golpe: con el sonar 2,4 cm más
//    adelante que en la variante histórica, 10 cm de lectura dejan la misma distancia eje-prisma que 13 cm allí), se detiene, barre con la garra de su lado
//    aparcado al contrario y la devuelve a su sitio (la garra nunca queda junto al prisma apartado).
//  · El barrido desde la derecha (garra aparcada a +1: el 2.º obstáculo) empuja el prisma hacia fuera de la curva siguiente y necesita más holgura entre la
//    garra y el prisma: antes de barrer retrocede ≈ 1,2 cm (700 ms a −8 %). Con esa holgura el prisma queda a 8,4–9,0 cm del eje de la línea (sin ella, 7,1–7,9 cm).
//  · Después de cada barrido el sonar COMPRUEBA si el objeto sigue delante (≤ 22 cm). Si sigue, lo vuelve a intentar (hasta 3 barridos): en la salida de una
//    curva el primer barrido puede empezar con el robot aún girando y empujar el prisma solo a medias.
//  · Tras cada obstáculo, 15 s después (ya lejos de él) aparca la garra del lado contrario: el siguiente obstáculo se barre en sentido opuesto.
void setup(){inicializarMovimiento();inicializarSensores();inicializarGolpe();moverServoGolpe(-1);pausa(1200);botonInicio();}
int ult=0;int lost=0;int acc=0;int hold=0;int cool=0;int p=-1;int cambio=0;int lim=20;
void seguir(int base,int dentro,int fuera){
 bool i=lineaIzquierda();bool c=lineaCentral();bool d=lineaDerecha();
 int suave=dentro+(fuera-dentro)/4;
 if(i||c||d){lost=0;}else{lost=lost+1;}
 acc=acc-acc/12;
 if(hold>0){hold=hold-1;}
 if(i&&!d){acc=acc-12;}
 if(d&&!i){acc=acc+12;}
 if(i&&c&&d){avanzar(base);}
 else if(i&&c){avanzar(suave,fuera);ult=-1;}
 else if(c&&d){avanzar(fuera,suave);ult=1;}
 else if(i){avanzar(dentro,fuera);ult=-1;}
 else if(d){avanzar(fuera,dentro);ult=1;}
 else if(c){avanzar(fuera);}
 else if(lost==1){
  int m=0-acc;
  if(hold==0 && m>lim){avanzar(-7,7);pausa(300);hold=900;}
  if(hold==0 && acc>lim){avanzar(7,-7);pausa(300);hold=900;}
  avanzar(base);
 }
 else if(lost<35){if(ult<0){avanzar(base-9,base+9);}else{avanzar(base+9,base-9);}}
 else if(lost<110){if(ult<0){avanzar(base+9,base-9);}else{avanzar(base-9,base+9);}}
 else if(lost<900){avanzar(base);} else if(ult<0){avanzar(0-dentro,fuera-4);} else {avanzar(fuera-4,0-dentro);}
 pausa(5);
}
void barrer(){
 detenerse();pausa(300);
 if(p>0){avanzar(-8);pausa(700);detenerse();pausa(300);}
 moverServoGolpe(0-p);pausa(1500);
 moverServoGolpe(p);pausa(1200);
}
void loop(){
 if(cool>0){cool=cool-1;}
 if(cambio>0){cambio=cambio-1;if(cambio==0){p=0-p;moverServoGolpe(p);}}
 if(cool==0 && leerDistanciaSonar()<=22){
  int k=0;
  while(k<3 && leerDistanciaSonar()<=22){
   int n=0;
   while(leerDistanciaSonar()>10 && n<600){seguir(12,4,13);n=n+1;}
   barrer();k=k+1;
  }
  cool=1500;cambio=3000;
 }
 seguir(22,6,24);
}
