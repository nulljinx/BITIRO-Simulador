// FIRVI 2025 · programa de REFERENCIA para la prueba de integración (NO es el programa inicial de los estudiantes).
// Solo usa sus sensores (3 de línea y sonar), el servo de golpe y el tiempo. No conoce coordenadas, rutas ni la posición de los prismas.
//  · Sigue la línea con los tres sensores (giro fuerte si solo ve un lado, suave si ve el centro y un lado).
//  · Los sensores van 8 cm delante del eje: al acabarse una curva el robot aún no ha terminado de girar. Recuerda (acc) si venía corrigiendo
//    hacia un lado y, al perder la línea, termina ese giro un instante antes de avanzar recto (una vez cada 15 s, ver hold).
//  · Los gaps se cruzan avanzando recto mientras no hay línea (lost); al volver a verla sigue normal.
//  · Cuando el sonar ve un objeto a menos de 22 cm, se acerca despacio SIGUIENDO la línea hasta quedar a 13 cm (distancia de golpe),
//    se detiene, barre con la garra de su lado aparcado al contrario y la devuelve a su sitio (la garra nunca queda junto al prisma apartado).
//  · Tras cada obstáculo, 15 s después (ya lejos de él) aparca la garra del lado contrario: el siguiente obstáculo se barre en sentido opuesto.
void setup(){inicializarMovimiento();inicializarSensores();inicializarGolpe();moverServoGolpe(-1);pausa(1200);botonInicio();}
int ult=0;int lost=0;int acc=0;int hold=0;int cool=0;int p=-1;int cambio=0;int lim=20;
void seguir(int base,int dentro,int fuera){
 bool i=lineaIzquierda();bool c=lineaCentral();bool d=lineaDerecha();
 int suave=dentro+(fuera-dentro)/4;
 if(i||c||d){lost=0;}else{lost=lost+1;}
 acc=acc-acc/12;
 if(hold>0){hold=hold-1;}
 if(i&&!d){acc=acc-12;}
 if(d&&!i){acc=acc+12;}
 if(i&&c&&d){avanzar(base);}
 else if(i&&c){avanzar(suave,fuera);ult=-1;}
 else if(c&&d){avanzar(fuera,suave);ult=1;}
 else if(i){avanzar(dentro,fuera);ult=-1;}
 else if(d){avanzar(fuera,dentro);ult=1;}
 else if(c){avanzar(fuera);}
 else if(lost==1){
  int m=0-acc;
  if(hold==0 && m>lim){avanzar(-7,7);pausa(300);hold=900;}
  if(hold==0 && acc>lim){avanzar(7,-7);pausa(300);hold=900;}
  avanzar(base);
 }
 else if(lost<900){avanzar(base);} else if(ult<0){avanzar(0-dentro,fuera-4);} else {avanzar(fuera-4,0-dentro);}
 pausa(5);
}
void barrer(){
 detenerse();pausa(300);
 moverServoGolpe(0-p);pausa(1500);
 moverServoGolpe(p);pausa(1200);
}
void loop(){
 if(cool>0){cool=cool-1;}
 if(cambio>0){cambio=cambio-1;if(cambio==0){p=0-p;moverServoGolpe(p);}}
 if(cool==0 && leerDistanciaSonar()<=22){
  int n=0;
  while(leerDistanciaSonar()>13 && n<600){seguir(12,4,13);n=n+1;}
  barrer();cool=1500;cambio=3000;
 }
 seguir(22,6,24);
}
